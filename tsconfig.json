{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Node's types are needed by src/server.ts alone, which is a separate
    // entry point (`ses-lib/server`) precisely so that node:crypto never lands
    // in a browser bundle. Having the types available here does not put them
    // there — the export map decides that.
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
