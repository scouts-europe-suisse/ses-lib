#!/usr/bin/env bash
# Enable with: git config core.hooksPath .githooks
set -euo pipefail
# No `mapfile`: macOS ships bash 3.2.
staged=()
while IFS= read -r f; do staged+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACM)
[ "${#staged[@]}" -eq 0 ] && exit 0
exec ./scripts/check-no-internal.sh "${staged[@]}"
